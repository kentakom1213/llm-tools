#!/usr/bin/env zsh
set -euo pipefail

script_dir="${0:A:h}"
LLM_TOOLS_HOME="${LLM_TOOLS_HOME:-${script_dir:h}}"
source "$LLM_TOOLS_HOME/lib/common.zsh"
source "$LLM_TOOLS_HOME/lib/git-message.zsh"

command_name="commit-msg"
load_git_message_config "$command_name" "$config_file"
apply_git_message_env

usage () {
	cat <<'EOF'
Usage:
  llm-tools commit-msg [-m MODEL] [--temperature N] [--top-p N] [--top-k N] [--seed N] [--num-ctx N] [--ollama-parameter KEY=VALUE] [--max-diff-lines N] [--large-change-lines N] [--huge-change-lines N] [--huge-change-files N] [--full-diff] [--retry] [--debug]

Options:
  -m, --model MODEL       set Ollama model
  --temperature N         set Ollama temperature parameter
  --top-p N               set Ollama top_p parameter
  --top-k N               set Ollama top_k parameter
  --seed N                set Ollama seed parameter
  --num-ctx N             set Ollama num_ctx parameter
  --ollama-parameter KEY=VALUE
                          set an arbitrary Ollama model parameter
  --max-diff-lines N      limit staged diff lines sent to Ollama
  --large-change-lines N  use two-stage generation when changed lines exceed N
  --huge-change-lines N   use deterministic huge summary when changed lines exceed N
  --huge-change-files N   use deterministic huge summary when changed files exceed N
  --full-diff             send the full staged diff
  --retry                 retry once when automatic repair also fails
  --debug                 print raw model output to stderr
  --version               show version
  -h, --help              show this help
EOF
}

while (( $# > 0 ))
do
	case "${1:-}" in
		(-h | --help)
			usage
			exit 0
			;;
		(--version)
			llm_tools_version
			exit 0
			;;
		(--)
			shift
			break
			;;
		(-*)
			parse_git_message_option "$@" || die "unknown option: $1" 2
			consumed="$REPLY"
			shift "$consumed"
			;;
		(*)
			die "unexpected argument: $1" 2
			;;
	esac
done

require_git_message_model_config "$command_name"
validate_git_message_options

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
	die "commit-msg: not inside a git repository"
}

collect_git_diff_context \
	"git diff --cached --name-only" \
	"git diff --cached --numstat" \
	"git diff --cached --name-status" \
	"git diff --cached --stat" \
	"git diff --cached --no-ext-diff --minimal" \
	"commit-msg: no staged changes" \
	"hint: run git add -p or git add <file> first"

prompt="$(cat "$LLM_TOOLS_HOME/prompts/commit-msg.txt")"
context="$(
	cat <<EOF
Staged files:
$changed_files

Diff stat:
$diff_stat

Diff mode: $diff_mode
Changed lines estimate: $changed_lines
Binary files changed: $binary_files
Diff truncated: $truncated
Diff lines included: $included_diff_lines
Diff line limit: $diff_line_limit

Staged diff:
$git_diff
EOF
)"
change_size="$(classify_change_size)"

extract_msg () {
	sed 's/^[[:space:]]*//; s/[[:space:]]*$//' |
		sed '/^$/d' |
		sed -nE '/^(feat|fix|docs|style|refactor|test|chore|build|ci|perf)(\([^)]+\))?: .+/p' |
		head -n 1
}

repair_invalid_output () {
	local source_context="$1"

	cat <<EOF
TASK:
The previous output was invalid.
Regenerate one Conventional Commit message from the Git summary below.

GIT SUMMARY:
$source_context

FINAL INSTRUCTION:
Return exactly one valid Conventional Commit message and nothing else.
Do not summarize the input.
Do not ask a question.
EOF
}

case "$change_size" in
	(normal)
		generation_context="$context"
		output="$(
			build_commit_prompt "$prompt" "$context" |
				run_git_message_model "$model"
		)"
		;;
	(large)
		summary="$(
			build_summary_prompt "$context" |
				run_git_message_model "$model"
		)"
		generation_context="$summary"
		output="$(
			build_message_from_summary_prompt "$summary" |
				run_git_message_model "$model"
		)"
		;;
	(huge)
		summary="$(build_huge_summary)"
		generation_context="$summary"
		output="$(
			build_message_from_summary_prompt "$summary" |
				run_git_message_model "$model"
		)"
		;;
	(*)
		die "commit-msg: internal error: unknown change size: $change_size"
		;;
esac

if (( debug ))
then
	print -ru2 -- "----- commit-msg mode -----"
	print -ru2 -- "$change_size"
	if [[ "${summary:-}" != "" ]]
	then
		print -ru2 -- "----- generated summary -----"
		print -ru2 -- "$summary"
	fi
	print -ru2 -- "----- raw ollama output -----"
	print -ru2 -- "$output"
	print -ru2 -- "-----------------------------"
fi

msg="$(print -- "$output" | extract_msg)"

if [[ -n "$msg" ]]
then
	print -- "$msg"
else
	repair_output="$(
		repair_invalid_output "$generation_context" |
			run_git_message_model "$model"
	)"

	if (( debug ))
	then
		print -ru2 -- "----- repair ollama output -----"
		print -ru2 -- "$repair_output"
		print -ru2 -- "--------------------------------"
	fi

	msg="$(print -- "$repair_output" | extract_msg)"

	if [[ -n "$msg" ]]
	then
		print -- "$msg"
		exit 0
	fi

	if (( ! retry ))
	then
		print -ru2 -- "commit-msg: model did not return a valid commit message"
		print -ru2 -- "hint: retry with --retry --debug to inspect and retry once more"
		exit 1
	fi

	retry_output="$(
		repair_invalid_output "$generation_context" |
			run_git_message_model "$model"
	)"

	if (( debug ))
	then
		print -ru2 -- "----- retry ollama output -----"
		print -ru2 -- "$retry_output"
		print -ru2 -- "-------------------------------"
	fi

	msg="$(print -- "$retry_output" | extract_msg)"

	if [[ -n "$msg" ]]
	then
		print -- "$msg"
	else
		print -ru2 -- "commit-msg: model did not return a valid commit message"
		print -ru2 -- "hint: retry with --debug to inspect the raw output"
		exit 1
	fi
fi
